# Copy to .env.local. Nothing here is required: with none of it set the app runs
# on in memory fixtures, which is how the prototype is meant to be run today.

# Postgres on Neon. When set, the app switches from fixtures to the database and
# the /api/test-reset route disappears.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Brand strings. Nora is a working name, not a decided one (PROJECT.md 13).
# NEXT_PUBLIC_COMPANY_NAME=Nora
# NEXT_PUBLIC_FAMILY_APP_NAME=Nora
# NEXT_PUBLIC_DEFAULT_VOICE_NAME=Nora

# Turns on the Web Speech API recogniser. Off by default and it must stay off in
# any room with a resident in it: Chrome and Firefox both stream microphone
# audio to a cloud service, which breaks the mode one promise that no audio is
# transmitted. Use it with the team's own voices only.
# NEXT_PUBLIC_ALLOW_CLOUD_ASR=true
